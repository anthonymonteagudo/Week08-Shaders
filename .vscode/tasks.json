{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start shader classroom",
      "type": "process",
      "command": "node",
      "args": [
        "tools/serve.mjs"
      ],
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": ".*",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting",
          "endsPattern": "READY"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}